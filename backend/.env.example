# ==============================================================================
# TribalSetu Backend Environment Configuration (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    Windows:  copy .env.example .env
#    Linux/macOS: cp .env.example .env
# 2. Update the values below to match your local development environment.
# ==============================================================================

# Database Connection URL (PostgreSQL + psycopg2)
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database>
# For local default PostgreSQL:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/tribalsetu

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated origins allowed to make API requests)
# During local development with Flutter web / mobile emulator / desktop:
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# JWT Authentication Configuration
# Provide a secure, randomly generated secret key (min 32 chars in production)
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OTP Engine Configuration
OTP_HMAC_SECRET=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_DELIVERY_CHANNEL=console
REFRESH_TOKEN_EXPIRE_DAYS=7
RESEND_API_KEY=
OTP_EMAIL_SENDER=TribalSetu <onboarding@resend.dev>

# Gemini LLM Configuration (Google GenAI SDK)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
# If empty or not set, JAGO automatically falls back to deterministic rule-based assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash



